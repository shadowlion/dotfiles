{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5-5"
  },
  "permissions": {
    "allow": [
      "Bash(npx biome:*)"
    ]
  },
  "skillOverrides": {
    "5-whys-skill": "off",
    "ask-matt": "off",
    "chief-of-staff": "off",
    "claude-handoff": "off",
    "code-review": "off",
    "codebase-design": "off",
    "diagnose": "off",
    "diagnosing-bugs": "off",
    "domain-modeling": "off",
    "fallow": "off",
    "fallow-codex-onboarding": "off",
    "fallow-review": "off",
    "fallow-setup": "off",
    "git-guardrails-claude-code": "off",
    "grill-with-docs": "off",
    "grilling": "off",
    "handoff": "off",
    "hono": "off",
    "hono-jsx": "off",
    "hono-void": "off",
    "implement": "off",
    "implement-spec": "off",
    "improve-codebase-architecture": "off",
    "loop-me": "off",
    "migrate-to-shoehorn": "off",
    "modern-web-guidance": "off",
    "pr": "off",
    "pr-template": "off",
    "prototype": "off",
    "react-doctor": "off",
    "research": "off",
    "retro": "off",
    "scaffold-exercises": "off",
    "setup-matt-pocock-skills": "off",
    "setup-pre-commit": "off",
    "setup-ts-deep-modules": "off",
    "supabase": "off",
    "supabase-postgres-best-practices": "off",
    "tdd": "off",
    "teach": "off",
    "to-questionnaire": "off",
    "to-spec": "off",
    "to-tickets": "off",
    "triage": "off",
    "ub-mode": "off",
    "vercel-composition-patterns": "off",
    "vercel-react-best-practices": "off",
    "wait-what": "off",
    "wayfinder": "off",
    "web-design-guidelines": "off",
    "wizard": "off",
    "writing-beats": "off",
    "writing-fragments": "off",
    "writing-guidelines": "off",
    "writing-shape": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/justin/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolBatch": []
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "ponytail@ponytail": false,
    "modern-web-guidance@claude-plugins-official": false,
    "figma@synced": false,
    "open-code-review@open-code-review": false
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "zed-industries": {
      "source": {
        "source": "github",
        "repo": "zed-industries/delta-claude"
      }
    },
    "open-code-review": {
      "source": {
        "source": "github",
        "repo": "alibaba/open-code-review"
      }
    }
  },
  "sandbox": {
    "enabled": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "tui": "fullscreen",
  "theme": "dark-daltonized",
  "agentPushNotifEnabled": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: Not queryable (no remotes configured for this repo); assume private",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: Not queryable — no remotes configured and origin/HEAD unset",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine or CI runner with open internet",
      "**Source control**: The trusted repo (/Users/justin/.config/rex) only — no remotes configured, no additional orgs configured",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development",
      "**Trusted repo**: The git repository at /Users/justin/.config/rex (its working directory) — no remotes configured",
      "**Org-specific CLIs**: None configured"
    ]
  }
}
